rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cloud Backups (Production & Dev) - Strict User Ownership & Integrity
    match /user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }
    match /dev_user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    // Community Curated Lists
    match /community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media Reactions
    match /media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Media Reactions
    match /user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }

    // Daily Polls & Catalog
    match /daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }

    // Curated Cinephile Challenges Catalog
    match /curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cinephile Milestones Catalog
    match /cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media Discussions
    match /media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    match /dev_media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // User List Interactions
    match /user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    function isValidMatchRoomCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'roomCode', 'hostUserId', 'hostName', 'mode', 'status', 'deckJson', 'hostLikes', 'hostPasses', 'guestLikes', 'guestPasses', 'matches', 'createdAtEpochMs'])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 32
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16
        && data.hostUserId is string && data.hostUserId.size() > 0 && data.hostUserId.size() <= 128
        && data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 50
        && data.mode is string && (data.mode == 'REMOTE' || data.mode == 'COUCH')
        && data.status is string && (data.status == 'WAITING_FOR_GUEST' || data.status == 'SWIPING')
        && data.deckJson is string && data.deckJson.size() > 0 && data.deckJson.size() <= 500000
        && data.hostLikes is list && data.hostLikes.size() == 0
        && data.hostPasses is list && data.hostPasses.size() == 0
        && data.guestLikes is list && data.guestLikes.size() == 0
        && data.guestPasses is list && data.guestPasses.size() == 0
        && data.matches is list && data.matches.size() == 0
        && data.createdAtEpochMs is int;
    }

    function isValidMatchRoomUpdate() {
      let data = request.resource.data;
      let existing = resource.data;
      return data.id == existing.id
        && data.roomCode == existing.roomCode
        && data.hostUserId == existing.hostUserId
        && data.createdAtEpochMs == existing.createdAtEpochMs
        && data.deckJson == existing.deckJson
        && data.mode == existing.mode
        && data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 50
        && (data.guestUserId == null || (data.guestUserId is string && data.guestUserId.size() <= 128 && data.guestUserId != existing.hostUserId))
        && (data.guestName == null || (data.guestName is string && data.guestName.size() <= 50))
        && data.status is string
        && data.hostLikes is list && data.hostLikes.size() <= 100
        && data.hostPasses is list && data.hostPasses.size() <= 100
        && data.guestLikes is list && data.guestLikes.size() <= 100
        && data.guestPasses is list && data.guestPasses.size() <= 100
        && data.matches is list && data.matches.size() <= 100;
    }

    // Movie Match Rooms (Couples / Friends Swipe Night)
    match /match_rooms/{roomId} {
      allow read: if true;
      allow create: if isValidMatchRoomCreate();
      allow update: if isValidMatchRoomUpdate();
      allow delete: if false;
    }
    match /dev_match_rooms/{roomId} {
      allow read: if true;
      allow create: if isValidMatchRoomCreate();
      allow update: if isValidMatchRoomUpdate();
      allow delete: if false;
    }

    function isValidSecretListCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['shareCode', 'title', 'ownerUserId', 'isCollaborative', 'isRevoked', 'createdAtEpochMs', 'updatedAtEpochMs', 'itemsJson'])
        && data.shareCode is string && data.shareCode.size() >= 4 && data.shareCode.size() <= 20
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.ownerUserId is string && data.ownerUserId.size() > 0 && data.ownerUserId.size() <= 128
        && data.isCollaborative is bool
        && data.isRevoked == false
        && data.itemsJson is string && data.itemsJson.size() <= 1000000;
    }

    function isValidSecretListUpdate() {
      let data = request.resource.data;
      let existing = resource.data;
      // Cannot modify a list that is already revoked
      return !existing.isRevoked
        // Creator identity, share code, and creation timestamp are immutable
        && data.ownerUserId == existing.ownerUserId
        && data.shareCode == existing.shareCode
        && data.createdAtEpochMs == existing.createdAtEpochMs
        // Schema & type validity
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.isCollaborative is bool
        && data.isRevoked is bool
        && data.itemsJson is string && data.itemsJson.size() <= 1000000;
    }

    // Secret Shared Lists & Watchlists (Unlisted Private Sharing & Collaborative Co-Curators)
    // Production (End Users)
    match /secret_shared_lists/{shareCode} {
      allow read: if true;
      allow create: if isValidSecretListCreate();
      allow update: if isValidSecretListUpdate();
      allow delete: if false;
    }

    // Development & Testing (Isolated)
    match /dev_secret_shared_lists/{shareCode} {
      allow read: if true;
      allow create: if isValidSecretListCreate();
      allow update: if isValidSecretListUpdate();
      allow delete: if false;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
