rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cloud Backups (Production & Dev) - Strict User Ownership & Integrity
    match /user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }
    match /dev_user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    // Community Curated Lists
    match /community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reports/{reporterId} {
        allow read: if false;
        allow create, update: if request.auth != null && request.auth.uid == reporterId;
        allow delete: if false;
      }
    }
    match /dev_community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reports/{reporterId} {
        allow read: if false;
        allow create, update: if request.auth != null && request.auth.uid == reporterId;
        allow delete: if false;
      }
    }

    // Media Reactions
    match /media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Media Reactions
    match /user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }

    // ===============================================================
    // Community Media Ratings & Histograms - Assumed Data Model
    // ===============================================================
    //
    // Collections: media_ratings/{mediaId}, dev_media_ratings/{mediaId}
    // Document ID: (movie|tv)_[0-9]+ (e.g., movie_550, tv_1399)
    // Fields:
    //   - ratingCount: int (required, >= 0; == 1 on create; delta in [-1, 1] on update)
    //   - ratingSum: number (required, >= 0; in [0.5, 5.0] on create; delta in [-5.0, 5.0] on update)
    //   - averageRating: number (required, in [0, 5]; 0 when ratingCount == 0; matches ratingSum/ratingCount)
    //   - histogram: map (required, keys subset of ['0.5'..'5.0'], size <= 10, int values >= 0, sum == ratingCount)
    //   - updatedAt: timestamp (required, == request.time)
    //
    // Collections: user_media_ratings/{userRatingId}, dev_user_media_ratings/{userRatingId}
    // Document ID: {firebaseUid}_{mediaType}_{mediaId} (e.g., {uid}_movie_550)
    // Fields:
    //   - firebaseUid: string (required, == request.auth.uid, immutable)
    //   - mediaId: int (required, > 0, immutable)
    //   - mediaType: string (required, 'movie' or 'tv', immutable)
    //   - rating: number (required, half-step in [0.5, 1.0, ..., 5.0])
    //   - updatedAt: timestamp (required, == request.time)
    // ===============================================================

    function isRatingAuthenticated() {
      return request.auth != null;
    }

    function isValidRatingMediaDocId(mediaId) {
      return mediaId.size() <= 32 && mediaId.matches('^(movie|tv)_[0-9]+$');
    }

    function isValidUserRatingDocId(userRatingId) {
      return isRatingAuthenticated()
        && userRatingId.size() <= 160
        && userRatingId.matches('^' + request.auth.uid + '_(movie|tv)_[0-9]+$');
    }

    function isValidHalfStepRating(value) {
      return (value is int || value is float)
        && value in [0.5, 1, 1.0, 1.5, 2, 2.0, 2.5, 3, 3.0, 3.5, 4, 4.0, 4.5, 5, 5.0];
    }

    function isValidHistogramBucket(hist, key) {
      return !(key in hist) || (hist[key] is int && hist[key] >= 0);
    }

    function histogramBucketValue(hist, key) {
      return key in hist ? hist[key] : 0;
    }

    function histogramTotalCount(hist) {
      return histogramBucketValue(hist, '0.5')
        + histogramBucketValue(hist, '1.0')
        + histogramBucketValue(hist, '1.5')
        + histogramBucketValue(hist, '2.0')
        + histogramBucketValue(hist, '2.5')
        + histogramBucketValue(hist, '3.0')
        + histogramBucketValue(hist, '3.5')
        + histogramBucketValue(hist, '4.0')
        + histogramBucketValue(hist, '4.5')
        + histogramBucketValue(hist, '5.0');
    }

    function histogramWeightedSum(hist) {
      return histogramBucketValue(hist, '0.5') * 0.5
        + histogramBucketValue(hist, '1.0') * 1.0
        + histogramBucketValue(hist, '1.5') * 1.5
        + histogramBucketValue(hist, '2.0') * 2.0
        + histogramBucketValue(hist, '2.5') * 2.5
        + histogramBucketValue(hist, '3.0') * 3.0
        + histogramBucketValue(hist, '3.5') * 3.5
        + histogramBucketValue(hist, '4.0') * 4.0
        + histogramBucketValue(hist, '4.5') * 4.5
        + histogramBucketValue(hist, '5.0') * 5.0;
    }

    function isHistogramBucketDeltaValid(newHist, oldHist, key) {
      return math.abs(histogramBucketValue(newHist, key) - histogramBucketValue(oldHist, key)) <= 1;
    }

    function isHistogramDeltaValid(newHist, oldHist) {
      return oldHist is map
        && isHistogramBucketDeltaValid(newHist, oldHist, '0.5')
        && isHistogramBucketDeltaValid(newHist, oldHist, '1.0')
        && isHistogramBucketDeltaValid(newHist, oldHist, '1.5')
        && isHistogramBucketDeltaValid(newHist, oldHist, '2.0')
        && isHistogramBucketDeltaValid(newHist, oldHist, '2.5')
        && isHistogramBucketDeltaValid(newHist, oldHist, '3.0')
        && isHistogramBucketDeltaValid(newHist, oldHist, '3.5')
        && isHistogramBucketDeltaValid(newHist, oldHist, '4.0')
        && isHistogramBucketDeltaValid(newHist, oldHist, '4.5')
        && isHistogramBucketDeltaValid(newHist, oldHist, '5.0');
    }

    function isValidRatingHistogram(hist) {
      return hist is map
        && hist.keys().hasOnly(['0.5', '1.0', '1.5', '2.0', '2.5', '3.0', '3.5', '4.0', '4.5', '5.0'])
        && hist.size() <= 10
        && isValidHistogramBucket(hist, '0.5')
        && isValidHistogramBucket(hist, '1.0')
        && isValidHistogramBucket(hist, '1.5')
        && isValidHistogramBucket(hist, '2.0')
        && isValidHistogramBucket(hist, '2.5')
        && isValidHistogramBucket(hist, '3.0')
        && isValidHistogramBucket(hist, '3.5')
        && isValidHistogramBucket(hist, '4.0')
        && isValidHistogramBucket(hist, '4.5')
        && isValidHistogramBucket(hist, '5.0');
    }

    function isValidMediaRatingPayload(data) {
      return data.keys().hasOnly(['ratingCount', 'ratingSum', 'averageRating', 'histogram', 'updatedAt'])
        && data.keys().hasAll(['ratingCount', 'ratingSum', 'averageRating', 'histogram', 'updatedAt'])
        && data.ratingCount is int && data.ratingCount >= 0
        && (data.ratingSum is int || data.ratingSum is float)
        && data.ratingSum >= 0
        && data.ratingSum <= data.ratingCount * 5.0
        && (data.averageRating is int || data.averageRating is float)
        && data.averageRating >= 0 && data.averageRating <= 5
        && (
          (data.ratingCount == 0 && data.ratingSum == 0 && data.averageRating == 0) ||
          (data.ratingCount > 0
            && data.ratingSum >= data.ratingCount * 0.5
            && data.averageRating >= 0.5
            && math.abs(data.averageRating - (float(data.ratingSum) / float(data.ratingCount))) <= 0.01)
        )
        && isValidRatingHistogram(data.histogram)
        && histogramTotalCount(data.histogram) == data.ratingCount
        && math.abs(histogramWeightedSum(data.histogram) - data.ratingSum) < 0.001
        && data.updatedAt is timestamp && data.updatedAt == request.time;
    }

    function isLinkedUserRatingCreated(userRatingsCollection, mediaId, ratingSum) {
      let userPath = /databases/$(database)/documents/$(userRatingsCollection)/$(request.auth.uid + '_' + mediaId);
      return !exists(userPath)
        && existsAfter(userPath)
        && math.abs(ratingSum - getAfter(userPath).data.rating) < 0.001;
    }

    function isLinkedUserRatingTransitionValid(userRatingsCollection, mediaId, data, existing) {
      let userPath = /databases/$(database)/documents/$(userRatingsCollection)/$(request.auth.uid + '_' + mediaId);
      return (
        // New rating submitted by this user (+1 count)
        (data.ratingCount == existing.ratingCount + 1
          && !exists(userPath)
          && existsAfter(userPath)
          && math.abs((data.ratingSum - existing.ratingSum) - getAfter(userPath).data.rating) < 0.001)
        ||
        // Existing user updated their rating (0 count delta)
        (data.ratingCount == existing.ratingCount
          && exists(userPath)
          && existsAfter(userPath)
          && math.abs((data.ratingSum - existing.ratingSum) - (getAfter(userPath).data.rating - get(userPath).data.rating)) < 0.001)
        ||
        // Existing user removed their rating (-1 count)
        (data.ratingCount == existing.ratingCount - 1
          && exists(userPath)
          && !existsAfter(userPath)
          && (
            (data.ratingCount == 0 && data.ratingSum == 0) ||
            math.abs((existing.ratingSum - data.ratingSum) - get(userPath).data.rating) < 0.001
          ))
      );
    }

    function isValidMediaRatingCreate(mediaId, userRatingsCollection) {
      let data = request.resource.data;
      return isRatingAuthenticated()
        && isValidRatingMediaDocId(mediaId)
        && isValidMediaRatingPayload(data)
        && data.ratingCount == 1
        && data.ratingSum >= 0.5 && data.ratingSum <= 5.0
        && data.averageRating >= 0.5 && data.averageRating <= 5.0
        && isLinkedUserRatingCreated(userRatingsCollection, mediaId, data.ratingSum);
    }

    function isValidMediaRatingUpdate(mediaId, userRatingsCollection) {
      let data = request.resource.data;
      let existing = resource.data;
      return isRatingAuthenticated()
        && isValidRatingMediaDocId(mediaId)
        && isValidMediaRatingPayload(data)
        && existing.ratingCount is int
        && (existing.ratingSum is int || existing.ratingSum is float)
        && data.ratingCount >= existing.ratingCount - 1
        && data.ratingCount <= existing.ratingCount + 1
        && data.ratingSum >= existing.ratingSum - 5.0
        && data.ratingSum <= existing.ratingSum + 5.0
        && isHistogramDeltaValid(data.histogram, existing.histogram)
        && isLinkedUserRatingTransitionValid(userRatingsCollection, mediaId, data, existing);
    }

    function isLinkedMediaRatingUpdated(mediaRatingsCollection, mediaDocId) {
      let mediaPath = /databases/$(database)/documents/$(mediaRatingsCollection)/$(mediaDocId);
      return existsAfter(mediaPath)
        && getAfter(mediaPath).data.updatedAt == request.time;
    }

    function isValidUserMediaRatingPayload(userRatingId, mediaRatingsCollection) {
      let data = request.resource.data;
      return isRatingAuthenticated()
        && data.keys().hasOnly(['firebaseUid', 'mediaId', 'mediaType', 'rating', 'updatedAt'])
        && data.keys().hasAll(['firebaseUid', 'mediaId', 'mediaType', 'rating', 'updatedAt'])
        && data.firebaseUid is string && data.firebaseUid == request.auth.uid
        && data.mediaId is int && data.mediaId > 0
        && data.mediaType is string && data.mediaType in ['movie', 'tv']
        && isValidHalfStepRating(data.rating)
        && data.updatedAt is timestamp && data.updatedAt == request.time
        && userRatingId == request.auth.uid + '_' + data.mediaType + '_' + string(data.mediaId)
        && isLinkedMediaRatingUpdated(mediaRatingsCollection, data.mediaType + '_' + string(data.mediaId));
    }

    function isValidUserMediaRatingUpdate(userRatingId, mediaRatingsCollection) {
      let data = request.resource.data;
      let existing = resource.data;
      return isValidUserMediaRatingPayload(userRatingId, mediaRatingsCollection)
        && existing.firebaseUid == request.auth.uid
        && data.firebaseUid == existing.firebaseUid
        && data.mediaId == existing.mediaId
        && data.mediaType == existing.mediaType;
    }

    function isValidUserMediaRatingDelete(userRatingId, mediaRatingsCollection) {
      let existing = resource.data;
      return isValidUserRatingDocId(userRatingId)
        && existing.firebaseUid == request.auth.uid
        && existing.mediaType is string && existing.mediaType in ['movie', 'tv']
        && existing.mediaId is int && existing.mediaId > 0
        && userRatingId == request.auth.uid + '_' + existing.mediaType + '_' + string(existing.mediaId)
        && isLinkedMediaRatingUpdated(mediaRatingsCollection, existing.mediaType + '_' + string(existing.mediaId));
    }

    // Community Media Ratings & Histograms
    match /media_ratings/{mediaId} {
      allow read: if true;
      allow create: if isValidMediaRatingCreate(mediaId, 'user_media_ratings');
      allow update: if isValidMediaRatingUpdate(mediaId, 'user_media_ratings');
      allow delete: if false;
    }
    match /dev_media_ratings/{mediaId} {
      allow read: if true;
      allow create: if isValidMediaRatingCreate(mediaId, 'dev_user_media_ratings');
      allow update: if isValidMediaRatingUpdate(mediaId, 'dev_user_media_ratings');
      allow delete: if false;
    }

    // User Community Ratings
    match /user_media_ratings/{userRatingId} {
      allow get: if isValidUserRatingDocId(userRatingId)
        && (resource == null || resource.data.firebaseUid == request.auth.uid);
      allow list: if false;
      allow create: if isValidUserMediaRatingPayload(userRatingId, 'media_ratings');
      allow update: if isValidUserMediaRatingUpdate(userRatingId, 'media_ratings');
      allow delete: if isValidUserMediaRatingDelete(userRatingId, 'media_ratings');
    }
    match /dev_user_media_ratings/{userRatingId} {
      allow get: if isValidUserRatingDocId(userRatingId)
        && (resource == null || resource.data.firebaseUid == request.auth.uid);
      allow list: if false;
      allow create: if isValidUserMediaRatingPayload(userRatingId, 'dev_media_ratings');
      allow update: if isValidUserMediaRatingUpdate(userRatingId, 'dev_media_ratings');
      allow delete: if isValidUserMediaRatingDelete(userRatingId, 'dev_media_ratings');
    }

    // Daily Polls & Catalog
    match /daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }

    // Curated Cinephile Challenges Catalog
    match /curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cinephile Milestones Catalog
    match /cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media Discussions
    match /media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    match /dev_media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // User List Interactions
    match /user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    function isValidMatchRoomCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'roomCode', 'hostUserId', 'hostName', 'mode', 'status', 'deckJson', 'hostLikes', 'hostPasses', 'guestLikes', 'guestPasses', 'matches', 'createdAtEpochMs'])
        && data.id is string && data.id.size() >= 4 && data.id.size() <= 32
        && data.roomCode is string && data.roomCode.size() >= 4 && data.roomCode.size() <= 16
        && data.hostUserId is string && data.hostUserId.size() > 0 && data.hostUserId.size() <= 128
        && data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 50
        && data.mode is string && (data.mode == 'REMOTE' || data.mode == 'COUCH')
        && data.status is string && (data.status == 'WAITING_FOR_GUEST' || data.status == 'SWIPING')
        && data.deckJson is string && data.deckJson.size() > 0 && data.deckJson.size() <= 500000
        && data.hostLikes is list && data.hostLikes.size() == 0
        && data.hostPasses is list && data.hostPasses.size() == 0
        && data.guestLikes is list && data.guestLikes.size() == 0
        && data.guestPasses is list && data.guestPasses.size() == 0
        && data.matches is list && data.matches.size() == 0
        && data.createdAtEpochMs is int;
    }

    function isValidMatchRoomUpdate() {
      let data = request.resource.data;
      let existing = resource.data;
      return data.id == existing.id
        && data.roomCode == existing.roomCode
        && data.hostUserId == existing.hostUserId
        && data.createdAtEpochMs == existing.createdAtEpochMs
        && data.deckJson == existing.deckJson
        && data.mode == existing.mode
        && data.hostName is string && data.hostName.size() > 0 && data.hostName.size() <= 50
        && (data.guestUserId == null || (data.guestUserId is string && data.guestUserId.size() <= 128 && data.guestUserId != existing.hostUserId))
        && (data.guestName == null || (data.guestName is string && data.guestName.size() <= 50))
        && data.status is string
        && data.hostLikes is list && data.hostLikes.size() <= 100
        && data.hostPasses is list && data.hostPasses.size() <= 100
        && data.guestLikes is list && data.guestLikes.size() <= 100
        && data.guestPasses is list && data.guestPasses.size() <= 100
        && data.matches is list && data.matches.size() <= 100;
    }

    // Movie Match Rooms (Couples / Friends Swipe Night)
    match /match_rooms/{roomId} {
      allow read: if true;
      allow create: if isValidMatchRoomCreate();
      allow update: if isValidMatchRoomUpdate();
      allow delete: if false;
    }
    match /dev_match_rooms/{roomId} {
      allow read: if true;
      allow create: if isValidMatchRoomCreate();
      allow update: if isValidMatchRoomUpdate();
      allow delete: if false;
    }

    function isValidSecretListCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['shareCode', 'title', 'ownerUserId', 'isCollaborative', 'isRevoked', 'createdAtEpochMs', 'updatedAtEpochMs', 'itemsJson'])
        && data.shareCode is string && data.shareCode.size() >= 4 && data.shareCode.size() <= 20
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.ownerUserId is string && data.ownerUserId.size() > 0 && data.ownerUserId.size() <= 128
        && data.isCollaborative is bool
        && data.isRevoked == false
        && data.itemsJson is string && data.itemsJson.size() <= 1000000;
    }

    function isValidSecretListUpdate() {
      let data = request.resource.data;
      let existing = resource.data;
      // Cannot modify a list that is already revoked
      return !existing.isRevoked
        // Creator identity, share code, and creation timestamp are immutable
        && data.ownerUserId == existing.ownerUserId
        && data.shareCode == existing.shareCode
        && data.createdAtEpochMs == existing.createdAtEpochMs
        // Schema & type validity
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.isCollaborative is bool
        && data.isRevoked is bool
        && data.itemsJson is string && data.itemsJson.size() <= 1000000;
    }

    // Secret Shared Lists & Watchlists (Unlisted Private Sharing & Collaborative Co-Curators)
    // Production (End Users)
    match /secret_shared_lists/{shareCode} {
      allow read: if true;
      allow create: if isValidSecretListCreate();
      allow update: if isValidSecretListUpdate();
      allow delete: if false;
    }

    // Development & Testing (Isolated)
    match /dev_secret_shared_lists/{shareCode} {
      allow read: if true;
      allow create: if isValidSecretListCreate();
      allow update: if isValidSecretListUpdate();
      allow delete: if false;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
