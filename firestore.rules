rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Cloud Backups (Production & Dev) - Strict User Ownership & Integrity
    match /user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }
    match /dev_user_backups/{backupId} {
      allow read: if request.auth != null && (
        request.auth.uid == backupId ||
        (resource != null && resource.data.firebaseUid == request.auth.uid) ||
        (resource != null && resource.data.uid == request.auth.uid)
      );
      allow create: if request.auth != null && (
        request.auth.uid == backupId ||
        request.resource.data.firebaseUid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
      allow update: if request.auth != null && (
        (request.auth.uid == backupId || resource.data.firebaseUid == request.auth.uid || resource.data.uid == request.auth.uid) &&
        (request.auth.uid == backupId || request.resource.data.firebaseUid == request.auth.uid || request.resource.data.uid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        request.auth.uid == backupId ||
        resource.data.firebaseUid == request.auth.uid ||
        resource.data.uid == request.auth.uid
      );
    }

    // Community Curated Lists
    match /community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_community_curated_lists/{listId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media Reactions
    match /media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_media_reactions/{mediaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User Media Reactions
    match /user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_media_reactions/{userReactionId} {
      allow read, write: if request.auth != null;
    }

    // Daily Polls & Catalog
    match /daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /dev_daily_poll_catalog/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_daily_poll_votes/{voteId} {
      allow read, write: if request.auth != null;
    }

    // Curated Cinephile Challenges Catalog
    match /curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_curated_challenges/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cinephile Milestones Catalog
    match /cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if false;
    }
    match /dev_cinephile_milestones/{catalogId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Media Discussions
    match /media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }
    match /dev_media_discussions/{discussionId} {
      allow read: if true;
      allow write: if request.auth != null;
      match /threads/{threadId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // User List Interactions
    match /user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }
    match /dev_user_list_interactions/{interactionId} {
      allow read, write: if request.auth != null;
    }

    // Movie Match Rooms (Couples / Friends Swipe Night)
    match /match_rooms/{roomId} {
      allow read, write: if true;
    }
    match /dev_match_rooms/{roomId} {
      allow read, write: if true;
    }

    // Secret Shared Lists & Watchlists (Unlisted Private Sharing & Collaborative Co-Curators)
    match /secret_shared_lists/{shareCode} {
      allow read, write: if true;
    }
    match /dev_secret_shared_lists/{shareCode} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
