#!/usr/bin/env bash
# ShowTime Pre-Commit Quality & Formatting Hook
# Validates code against docs/CODE_QUALITY_AND_SECURITY_GUIDE.md

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

echo -e "\n${BOLD}${BLUE}==> [ShowTime Quality Gate] Running Pre-Commit Validations...${NC}"

# Get list of staged files (Added, Copied, Modified)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}No staged files to check.${NC}"
    exit 0
fi

# Filter staged files by extension
STAGED_KT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(kt|kts)$' || true)
STAGED_JAVA_FILES=$(echo "$STAGED_FILES" | grep -E '\.java$' || true)
STAGED_XML_FILES=$(echo "$STAGED_FILES" | grep -E '\.xml$' || true)
STAGED_CODE_FILES=$(echo "$STAGED_FILES" | grep -E '\.(kt|kts|java|xml)$' || true)

# -----------------------------------------------------------------------------
# STEP 1: Auto-Reformat & Cleanup (Cmd + Option + L / Ctrl + Option + O)
# -----------------------------------------------------------------------------
FORMATTER_BIN=""
if [ -x "/Applications/Android Studio.app/Contents/bin/format.sh" ]; then
    FORMATTER_BIN="/Applications/Android Studio.app/Contents/bin/format.sh"
elif [ -x "/Applications/Android Studio Preview.app/Contents/bin/format.sh" ]; then
    FORMATTER_BIN="/Applications/Android Studio Preview.app/Contents/bin/format.sh"
elif [ -x "/Applications/IntelliJ IDEA.app/Contents/bin/format.sh" ]; then
    FORMATTER_BIN="/Applications/IntelliJ IDEA.app/Contents/bin/format.sh"
elif command -v format.sh &> /dev/null; then
    FORMATTER_BIN=$(command -v format.sh)
fi

if [ -z "$STAGED_CODE_FILES" ]; then
    echo -e "${GREEN}--> [1/2] No code files (.kt, .java, .xml) staged; skipping auto-reformat.${NC}"
elif [ -n "$FORMATTER_BIN" ]; then
    echo -e "${CYAN}--> [1/2] Auto-reformatting staged files with Android Studio Formatter (Cmd+Option+L)...${NC}"
    
    FORMAT_TARGETS=()
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            FORMAT_TARGETS+=("$file")
        fi
    done <<< "$STAGED_CODE_FILES"

    if [ ${#FORMAT_TARGETS[@]} -gt 0 ]; then
        # Run formatter quietly
        "$FORMATTER_BIN" -allowDefaults "${FORMAT_TARGETS[@]}" > /dev/null 2>&1 || true
        
        # Re-stage formatted files
        for file in "${FORMAT_TARGETS[@]}"; do
            git add "$file"
        done
        echo -e "${GREEN}    [✓] Auto-reformat applied and re-staged.${NC}"
    fi
else
    echo -e "${YELLOW}--> [1/2] Android Studio CLI formatter not found; skipping auto-reformat step.${NC}"
fi

# -----------------------------------------------------------------------------
# STEP 2: Code Quality & Security Checklist Verification
# -----------------------------------------------------------------------------
echo -e "${CYAN}--> [2/2] Validating staged files against Code Quality Checklist...${NC}"

HAS_ERRORS=0

# Helper function to report errors
report_error() {
    local rule_title="$1"
    local file="$2"
    local line_num="$3"
    local line_content="$4"
    local guide_ref="$5"

    echo -e "${RED}[VIOLATION] ${BOLD}${rule_title}${NC}"
    echo -e "  ${PURPLE}File:${NC} ${file}:${line_num}"
    echo -e "  ${YELLOW}Code:${NC} ${line_content}"
    echo -e "  ${BLUE}Guide:${NC} ${guide_ref}"
    echo ""
    HAS_ERRORS=1
}

# 1. Zero Wildcard Imports
for file in $STAGED_KT_FILES $STAGED_JAVA_FILES; do
    [ -f "$file" ] || continue
    while IFS=: read -r line_num line_content; do
        report_error "Wildcard import found (import .*)" \
            "$file" "$line_num" "$line_content" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#4-code-hygiene--linting-standards"
    done < <(grep -nE "^import +[a-zA-Z0-9_.]+\.\*" "$file" || true)
done

# 1b. Zero Inline Fully Qualified Class Names (Must Use Top-Level Imports)
for file in $STAGED_KT_FILES $STAGED_JAVA_FILES; do
    [ -f "$file" ] || continue
    if [[ "$file" =~ /test/ ]] || [[ "$file" =~ /androidTest/ ]]; then
        continue
    fi
    while IFS=: read -r line_num line_content; do
        # Ignore package declarations, import statements, comments, or string literals
        if [[ "$line_content" =~ ^[[:space:]]*(package|import|//|\*) ]] || [[ "$line_content" =~ \"com\.ssverma\. ]]; then
            continue
        fi
        report_error "Inline fully qualified class name (FQCN) found. Add an explicit top-level import instead." \
            "$file" "$line_num" "$line_content" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#4-code-hygiene--linting-standards"
    done < <(grep -nE "com\.ssverma\.[a-zA-Z0-9_.]+" "$file" || true)
done

# 2. Zero Hardcoded Hex Colors in UI Composables
for file in $STAGED_KT_FILES; do
    [ -f "$file" ] || continue
    # Skip design token and theme palette definition files
    if [[ "$file" =~ (Color|Theme|Palette|Spacing|Default|Brush)\.kt$ ]] || [[ "$file" =~ /test/ ]] || [[ "$file" =~ /androidTest/ ]]; then
        continue
    fi
    while IFS=: read -r line_num line_content; do
        report_error "Hardcoded Hex Color found. Use MaterialTheme.colorScheme tokens instead." \
            "$file" "$line_num" "$line_content" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#2-design-system--token-purity"
    done < <(grep -nE "Color\((0x[0-9a-fA-F]{6,8}|[0-9]+)\)" "$file" || true)
done

# 2b. Zero Raw ModalBottomSheet Outside ShowTimeBottomSheet
for file in $STAGED_KT_FILES; do
    [ -f "$file" ] || continue
    if [[ "$file" =~ ShowTimeBottomSheet\.kt$ ]] || [[ "$file" =~ /test/ ]] || [[ "$file" =~ /androidTest/ ]]; then
        continue
    fi
    while IFS=: read -r line_num line_content; do
        # Ignore comments
        if [[ "$line_content" =~ ^[[:space:]]*// ]]; then
            continue
        fi
        report_error "Raw ModalBottomSheet found. Use ShowTimeBottomSheet for universal backpress support and animations." \
            "$file" "$line_num" "$line_content" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#3-modal-bottom-sheets--backpress-handling"
    done < <(grep -nE "\bModalBottomSheet\(" "$file" || true)
done

# 2c. Zero Modifier.clickable on Surface / Card (Use Container onClick Parameter)
if command -v python3 &> /dev/null && [ -n "$STAGED_KT_FILES" ]; then
    while IFS=: read -r file line_num container_name bad_call; do
        [ -n "$file" ] || continue
        report_error "${container_name} uses Modifier.${bad_call}. Use ${container_name}(onClick = ...) to preserve shape ripple animation." \
            "$file" "$line_num" "${container_name}(...${bad_call}...)" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#4-interactive-source--ripple-preservation"
    done < <(python3 - "$STAGED_KT_FILES" << 'PYEOF'
import sys, re

file_list = sys.argv[1].split()
pattern = re.compile(r"\b(Surface|Card|ElevatedCard|OutlinedCard)\s*\(")
clickable_pattern = re.compile(r"\.(clickable|combinedClickable)\s*[\(\{]")

for file_path in file_list:
    if "/test/" in file_path or "/androidTest/" in file_path or not file_path.endswith((".kt", ".kts")):
        continue
    try:
        with open(file_path, "r", encoding="utf-8", errors="ignore") as fh:
            content = fh.read()
    except Exception:
        continue

    for match in pattern.finditer(content):
        start = match.end() - 1
        depth = 0
        in_string = False
        in_char = False
        in_line_comment = False
        in_block_comment = False
        end = -1
        i = start
        while i < len(content):
            c = content[i]
            if in_line_comment:
                if c == "\n":
                    in_line_comment = False
            elif in_block_comment:
                if c == "*" and i + 1 < len(content) and content[i+1] == "/":
                    in_block_comment = False
                    i += 1
            elif in_string:
                if c == "\\" and i + 1 < len(content):
                    i += 1
                elif c == "\"":
                    in_string = False
            elif in_char:
                if c == "\\" and i + 1 < len(content):
                    i += 1
                elif c == "\x27":
                    in_char = False
            else:
                if c == "/" and i + 1 < len(content) and content[i+1] == "/":
                    in_line_comment = True
                    i += 1
                elif c == "/" and i + 1 < len(content) and content[i+1] == "*":
                    in_block_comment = True
                    i += 1
                elif c == "\"":
                    in_string = True
                elif c == "\x27":
                    in_char = True
                elif c == "(":
                    depth += 1
                elif c == ")":
                    depth -= 1
                    if depth == 0:
                        end = i
                        break
            i += 1
        if end != -1:
            args_text = content[start:end+1]
            click_match = clickable_pattern.search(args_text)
            if click_match:
                line_num = content[:match.start() + click_match.start()].count("\n") + 1
                container_name = match.group(1)
                bad_call = click_match.group(0).strip()
                print(f"{file_path}:{line_num}:{container_name}:{bad_call}")
PYEOF
    )
fi

# 3. Zero Leftover Debug Logs / println in Production
for file in $STAGED_KT_FILES $STAGED_JAVA_FILES; do
    [ -f "$file" ] || continue
    # Skip build scripts, test files, and debug-specific tooling
    if [[ "$file" =~ \.gradle\.kts$ ]] || [[ "$file" =~ /test/ ]] || [[ "$file" =~ /androidTest/ ]] || [[ "$file" =~ /debug/ ]] || [[ "$file" =~ Debug.*\.kt$ ]]; then
        continue
    fi
    while IFS=: read -r line_num line_content; do
        # Ignore commented lines
        if [[ "$line_content" =~ ^[[:space:]]*// ]]; then
            continue
        fi
        report_error "Leftover debug log or print statement found in production code." \
            "$file" "$line_num" "$line_content" \
            "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#4-code-hygiene--linting-standards"
    done < <(grep -nE "(Log\.[dvew]\(|println\(|printStackTrace\(\)|System\.out\.print)" "$file" || true)
done

# 4. Zero Secrets or Sensitive Config Files
for file in $STAGED_FILES; do
    # Check forbidden file names
    if [[ "$file" =~ (core\.properties|local\.properties|\.jks|\.keystore|google-services\.json)$ ]]; then
        # Allow google-services.json if it is a template / public demo
        if [[ ! "$file" =~ google-services\.json$ ]]; then
            echo -e "${RED}[SECURITY VIOLATION] Sensitive secret file cannot be committed: ${BOLD}$file${NC}"
            HAS_ERRORS=1
        fi
    fi

    # Check for hardcoded API keys / tokens inside staged files
    if [ -f "$file" ] && [[ ! "$file" =~ \.(png|jpg|webp|jar|ico|so|apk)$ ]]; then
        while IFS=: read -r line_num line_content; do
            report_error "Potential API Key / Secret Token hardcoded in source." \
                "$file" "$line_num" "$line_content" \
                "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#6-security-secrets--privacy-standards"
        done < <(grep -nE "(api_key|apiKey|client_secret|clientSecret|private_key)\s*=\s*\"[a-zA-Z0-9_-]{24,}\"" "$file" || true)
    fi
done

# 5. Zero Production Mock Data Leakage
for file in $STAGED_KT_FILES; do
    [ -f "$file" ] || continue
    if [[ "$file" =~ src/main/ ]] && [[ ! "$file" =~ /debug/ ]] && [[ ! "$file" =~ /demo/ ]]; then
        while IFS=: read -r line_num line_content; do
            report_error "Synthetic mock/sample data leakage in production source (src/main)." \
                "$file" "$line_num" "$line_content" \
                "docs/CODE_QUALITY_AND_SECURITY_GUIDE.md#7-zero-hardcoded-data-for-production-builds--end-users"
        done < <(grep -nE "fun +(seedSample|createFake|generateMock)[a-zA-Z0-9_]*\(" "$file" || true)
    fi
done

# -----------------------------------------------------------------------------
# RESULT
# -----------------------------------------------------------------------------
if [ $HAS_ERRORS -ne 0 ]; then
    echo -e "${RED}${BOLD}========================================================================${NC}"
    echo -e "${RED}${BOLD}[FAILED] Pre-Commit Quality Checks Failed!${NC}"
    echo -e "${YELLOW}Please fix the violations listed above before committing.${NC}"
    echo -e "${YELLOW}To bypass in emergency: git commit --no-verify (-n)${NC}"
    echo -e "${RED}${BOLD}========================================================================${NC}\n"
    exit 1
else
    echo -e "${GREEN}${BOLD}==> [ShowTime Quality Gate] All checks passed cleanly! [✓]${NC}\n"
    exit 0
fi
