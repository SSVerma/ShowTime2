<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ShowTimeApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShowTime.Starting"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShowTime.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom Scheme Deep Links (showtime://...) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="showtime" />
            </intent-filter>

            <!-- Universal Android App Links (https://showtime.ssverma.in/...) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/movie" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/tv" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/person" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/people" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/lists" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/list" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/l" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/community" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/library" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/discover" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/discovery" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/browse" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/diary" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/taste" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/recommendations" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/wrapped" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/milestones" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/challenges" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/challenge" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/backlog" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/blindspot" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/blindspots" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/receipt" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/receipts" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/game" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/puzzle" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/match" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/matchroom" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/swipenight" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/home" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/dashboard" />
                <data
                    android:scheme="https"
                    android:host="showtime.ssverma.in"
                    android:pathPrefix="/search" />

                <data
                    android:scheme="https"
                    android:host="www.ssverma.in"
                    android:pathPrefix="/showtime" />
                <data
                    android:scheme="https"
                    android:host="ssverma.in"
                    android:pathPrefix="/showtime" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />

        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <meta-data
            android:name="com.google.android.gms.ads.flag.NATIVE_AD_DEBUGGER_ENABLED"
            android:value="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable automatic WorkManager initialization to prevent startup crashes -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Up Next Glance Widget Receiver -->
        <receiver
            android:name=".widget.upnext.UpNextWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_up_next_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/up_next_widget_info" />
        </receiver>

        <!-- Watchlist Glance Widget Receiver -->
        <receiver
            android:name=".widget.watchlist.WatchlistWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_watchlist_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/watchlist_widget_info" />
        </receiver>

    </application>

</manifest>